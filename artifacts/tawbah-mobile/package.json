{
  "name": "@workspace/tawbah-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-expo-router.js",
    "dev": "node scripts/patch-expo-router.js && (create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true) && EXPO_ROUTER_APP_ROOT=/home/runner/workspace/artifacts/tawbah-mobile/app BROWSER=none expo start --web --port 24800",
    "start": "node scripts/patch-expo-router.js && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo \"Native APK builds are not configured; use Replit Expo Launch for iOS publishing\"",
    "serve": "npx serve dist --listen tcp://0.0.0.0:${PORT:-24800} --single",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.28",
    "expo-av": "^16.0.8",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-font": "^57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-linking": "~57.0.12",
    "expo-location": "^57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-sensors": "^57.0.3",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "^57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.7.0",
    "nativewind": "^4.1.23",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-native/metro-config": "^0.86.3",
    "@types/react": "~19.2.14",
    "create-launch": "0.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
